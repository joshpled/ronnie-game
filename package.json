{
  "name": "ronnie-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src tests index.html *.md docs *.json *.ts *.js .github/workflows public/manifest.webmanifest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsc -p tsconfig.test.json && node --test .tests/tests/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^10.10.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "6.4.3"
  }
}
